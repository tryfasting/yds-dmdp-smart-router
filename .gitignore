# Environments
.env
.venv
.uv-cache/
__pycache__/
.pytest_cache/

# Private data (customer logs, labels, predictions) - never commit
/data/
*.csv
*.json
!examples/synthetic/*.csv
!examples/synthetic/*.json

# Model weights (root-level only; src/smartrouter/models/ is source code)
/models/
*.safetensors
*.bin
*.ckpt

# Logs
/logs/
*.log

# Docs: presentation files stay private, markdown docs are tracked
/docs/*
!/docs/*.md

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
